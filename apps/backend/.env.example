# Port on which the backend server runs
PORT=5000

# Secret key for signing JWT tokens
JWT_SECRET=your_jwt_secret_key_here

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ss_management_db?retryWrites=true&w=majority

# Allowed frontend URL(s) for CORS (e.g. https://your-app.vercel.app or comma-separated)
CLIENT_URL=http://localhost:3000,http://localhost:5173
